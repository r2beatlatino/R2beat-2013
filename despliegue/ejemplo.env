# Copiá esto a /opt/r2b2013/prod.env o /opt/r2b2013/prueba.env y completalo. ⛔ No va al repo.
#
# prod:   R2_ENTORNO=prod   R2_PUERTOS=0
# prueba: R2_ENTORNO=prueba R2_PUERTOS=1000   (login 49004: así corren los dos en el mismo VPS)
R2_ENTORNO=prueba
R2_PUERTOS=1000
# la IP pública del VPS, si está detrás de NAT (Oracle, AWS…). Vacía = la autodetecta
R2_PUBLIC_IP=
# las carpetas del VPS: las cuentas (se crean solas) y las tablas/notas de tu cliente
R2_DATOS_DIR=/opt/r2b2013/prueba-datos
R2_JUEGO_DIR=/opt/r2b2013/juego
